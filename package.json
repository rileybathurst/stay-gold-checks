{
  "name": "stay-gold",
  "version": "1.5.0",
  "type": "module",
  "description": "Checks and balances for code quality. Run as a dev dependency in any project.",
  "main": "dist/index.js",
  "author": "Riley Bathurst <riley@rileybathurst.com> (https://rileybathurst.com)",
  "files": [
    "dist",
    "named-colors.ts",
    "README.md"
  ],
  "bin": {
    "stay-gold-find": "dist/bang.js",
    "stay-gold-todos": "dist/todos.js",
    "stay-gold-css-vars": "dist/css-vars.js",
    "stay-gold-css-named-colors": "dist/css-named-colors.js",
    "stay-gold-css-variable-usage": "dist/css-variable-usage.js",
    "stay-gold-css-section-index": "dist/css-section-index.js",
    "stay-gold": "dist/index.js",
    "stay-gold-graphql-query-names": "dist/graphql-query-names.js",
    "stay-gold-package-framework-deps": "dist/package-json-framework-deps.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "gold": "npm run find && npm run todos && npm run variables && npm run named-colors && echo 'All checks passed!' || echo 'Some checks failed!'",
    "release": "npm run build && npm version patch && npm login && npm publish"
  },
  "keywords": [
    "code-quality",
    "lint",
    "css",
    "typescript",
    "javascript",
    "todos",
    "variables",
    "named-colors"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vitest/ui": "^4.0.5",
    "string-checker": "latest",
    "typescript": "^5.9.2",
    "vitest": "^4.0.5"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
